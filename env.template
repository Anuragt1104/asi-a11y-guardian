# A11y Guardian Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# LOCAL TESTING CONFIGURATION
# ============================================

# Agent Addresses (auto-generated on first run)
# After starting each agent, copy its address from console output
# Format: agent1qxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ORCHESTRATOR_ADDR=
ORCH_FETCHER_ADDR=
ORCH_ANALYZER_ADDR=
ORCH_METTA_ADDR=
ORCH_RESOURCES_ADDR=

# Optional: LLM API Keys (not required for current agent logic)
# Current implementation uses rule-based analysis, not LLM calls
OPENAI_API_KEY=
CLAUDE_API_KEY=

# ============================================
# AGENTVERSE DEPLOYMENT CONFIGURATION
# ============================================
# Add these values when deploying to Agentverse

# Agentverse API Token
# Get from: https://agentverse.ai/profile/api-keys
AGENTVERSE_TOKEN=

# Mailbox Secret (per-agent, set in Agentverse UI)
# Copy from agent settings after registration
MAILBOX_SECRET=

# ASI:One Integration
# Get from ASI:One dashboard if needed
ASI_ONE_API_KEY=

# ============================================
# NOTES
# ============================================
# 1. For local testing: Only agent addresses are needed
# 2. Addresses are printed to console when agents start
# 3. Copy addresses and paste them above, then restart agents
# 4. For Agentverse deployment: Set AGENTVERSE_TOKEN and MAILBOX_SECRET

